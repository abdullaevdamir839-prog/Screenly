# 1. Create a LiveKit Cloud project: https://cloud.livekit.io/
# 2. Find these values in your LiveKit project settings.
#    URL example: wss://screenly-abc123.livekit.cloud
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Closed-alpha access code, shared ONLY with invited testers.
# Choose a long non-trivial secret (not 123456). Keep out of Git.
ALPHA_ACCESS_CODE=REPLACE_WITH_LONG_RANDOM_CODE

# Generate two DIFFERENT strong random secrets using:
# node scripts/generate-secrets.mjs
ALPHA_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
ROOM_SIGNING_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS

# Optional: explicit HTTPS origin when later deployed behind a reverse proxy.
# Do not set for local development. Example: https://screenly.example.com
# SITE_ORIGIN=https://screenly.example.com

# Optional: local JSON database. Default: ./data/screenly.json
# SCREENLY_DATA_PATH=C:/Screenly/data/screenly.json

# Note: The 13-17 and 18+ test modes have the same core features.
# Public rooms and random matches remain SEPARATED by self-declared age group.
# This is NOT verified age assurance and is NOT sufficient for a public 13+ launch.

# === Screenly 1.7 Online Beta ===
# Set only on your hosted server or for local PostgreSQL testing.
# On Render use INTERNAL database URL in the same region; never commit it to Git.
# DATABASE_URL=postgresql://user:password@private-host:5432/dbname
# SITE_ORIGIN=https://your-screenly.onrender.com
# LiveKit secrets above stay server-side. Do not prefix them with NEXT_PUBLIC_.
# Public 13+ launch is DISABLED: invite-only testers, no open enrollment.
